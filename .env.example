# $DOOMHOUND Website — Environment Variables
# Copy this to .env and fill in the values

# Database (SQLite — Render uses persistent disk path)
DATABASE_URL=file:./dev.db

# Arena API (get from https://arena.social developer settings)
ARENA_API_KEY=

# $DOOMHOUND contract on Avalanche — SET AFTER TOKEN LAUNCH
DOOMHOUND_CONTRACT=
DOOMHOUND_SUBJECT_ID=

# Avalanche RPC for balance checks
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
