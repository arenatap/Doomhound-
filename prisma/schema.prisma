generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== DOOMHOUND PACK MEMBERS =====
model PackMember {
  id               String    @id @default(cuid())
  handle           String    @unique    // Arena handle (without @)
  userName         String               // Display name from Arena
  profilePic       String               // Profile picture URL
  walletAddress    String?              // Wallet address from Arena profile
  points           Int       @default(0)
  rank             String    @default("Lost Soul")
  lastCheckIn      DateTime?            // Last daily check-in

  // Arena activity tracking (for API-verified points)
  lastThreadCount  Int       @default(0)  // Arena threadCount at last verify
  lastFollowerCount Int      @default(0)  // Arena followerCount at last verify
  lastVerifiedAt   DateTime?              // Last time we verified via Arena API

  // $DOOMHOUND balance
  doomhoundBalance Float     @default(0)
  balanceCheckedAt DateTime?

  // Streak & Achievements
  streakCount      Int       @default(0)
  lastStreakAt     DateTime?
  achievements     String    @default("[]")   // JSON array: [{"id":"first_blood","name":"First Blood","emoji":"🩸","awardedAt":"..."}]

  // Wheel of Doom
  lastWheelSpin    DateTime?             // Last wheel spin timestamp
  pendingWinnings  Float     @default(0) // $DOOMHOUND won but not yet sent
  totalWheelSpins  Int       @default(0) // Total spins ever
  totalWheelWinnings Float   @default(0) // Total $DOOMHOUND won from wheel
  prizeSent        Boolean   @default(false) // Whether last prize was sent

  // Session (persistent login via cookie + DB)
  sessionToken     String?   @unique    // UUID token for cookie-based session

  // Referral
  referredBy       String?

  // Staking (auto-updated from on-chain balance)
  stakedAmount        Float     @default(0)    // Last verified DOOMHOUND balance
  stakingTier         String    @default("none") // none, bronze, silver, gold, diamond
  pendingStakingReward Int      @default(0)    // Accumulated staking points not yet claimed
  lastStakingUpdate   DateTime?                // Last time staking balance was verified

  // Airdrop (graduation airdrop — points counted from snapshot)
  airdropPointsStart  Int       @default(0)    // Points at time of airdrop snapshot (subtracted for leaderboard)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities       ActivityLog[]
  raffleTickets    RaffleTicket[]

  @@index([handle])
  @@index([points])
}

model ActivityLog {
  id           String   @id @default(cuid())
  memberHandle String             // Arena handle (FK)
  type         String              // register, daily_checkin, arena_post, arena_follower, trending_mention, meme_generated, referral, doomhound_holder, wheel_spin, raffle_ticket, staking_reward
  description  String
  points       Int
  createdAt    DateTime @default(now())

  member       PackMember @relation(fields: [memberHandle], references: [handle], onDelete: Cascade)

  @@index([memberHandle])
  @@index([createdAt])
}

// ===== DOOMHOUND DAO =====
model DaoSettings {
  id           String   @id @default(cuid())
  key          String   @unique   // e.g. "categories", "voting_duration_hours", "quorum", "approval_threshold", "proposer_min_points"
  value        String              // JSON string for complex values, or simple string/number
  updatedAt    DateTime @updatedAt
}

model DaoProposal {
  id             String   @id @default(cuid())
  title          String
  description    String
  category       String              // burn, pack, treasury, nft, marketing
  status         String   @default("active")  // active, passed, failed, executed, cancelled
  createdBy      String              // Arena handle of the proposer (admin)
  votingEndsAt   DateTime            // When voting closes
  quorum         Int      @default(3)          // Min number of voters required
  approvalPct    Int      @default(50)         // Percentage needed to pass (50 = 50%+1)
  snapshotData   String   @default("{}")       // JSON: { handle: points } snapshot at creation time
  resultData     String?             // JSON: { totalVotes, yesVotes, noVotes, passed } after closing

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  votes          DaoVote[]

  @@index([status])
  @@index([category])
  @@index([votingEndsAt])
}

model DaoVote {
  id           String   @id @default(cuid())
  proposalId   String                          // FK to DaoProposal
  memberHandle String                          // Arena handle of the voter
  vote         String                          // "yes" or "no"
  votingPower  Int                             // Points at time of vote
  createdAt    DateTime @default(now())

  proposal     DaoProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, memberHandle])  // One vote per member per proposal
  @@index([proposalId])
  @@index([memberHandle])
}

// ===== PACK RAFFLE =====
model Raffle {
  id            String   @id @default(cuid())
  prizeAmount   Float    @default(100000)  // $DOOMHOUND prize for the winner
  ticketPrice   Int      @default(50)      // Points per ticket
  startDate     DateTime                   // When the raffle opens
  endDate       DateTime                   // When the raffle closes (drawing time)
  status        String   @default("open")  // open, closed, drawn
  winnerHandle  String?                    // Arena handle of the winner
  rolledOver    Boolean  @default(false)   // Whether prize was rolled over from previous

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tickets       RaffleTicket[]

  @@index([status])
  @@index([endDate])
}

model RaffleTicket {
  id           String   @id @default(cuid())
  raffleId     String                       // FK to Raffle
  memberHandle String                       // Arena handle of buyer
  quantity     Int      @default(1)         // Number of tickets in this purchase
  pointsSpent  Int                          // Total points spent
  createdAt    DateTime @default(now())

  raffle       Raffle    @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  member       PackMember @relation(fields: [memberHandle], references: [handle], onDelete: Cascade)

  @@index([raffleId])
  @@index([memberHandle])
}
